<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.process.mapper.BizDeviceModelMapper">
    
    <resultMap type="BizDeviceModel" id="BizDeviceModelResult">
        <result property="modelId"    column="model_id"    />
        <result property="modelName"    column="model_name"    />
        <result property="description"    column="description"    />
    </resultMap>

    <sql id="selectBizDeviceModelVo">
        select model_id, model_name, description from biz_device_model
    </sql>

    <select id="selectBizDeviceModelList" parameterType="BizDeviceModel" resultMap="BizDeviceModelResult">
        <include refid="selectBizDeviceModelVo"/>
        <where>  
            <if test="modelName != null  and modelName != ''"> and model_name like concat('%', #{modelName}, '%')</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
        </where>
    </select>
    
    <select id="selectBizDeviceModelByModelId" parameterType="Long" resultMap="BizDeviceModelResult">
        <include refid="selectBizDeviceModelVo"/>
        where model_id = #{modelId}
    </select>

    <insert id="insertBizDeviceModel" parameterType="BizDeviceModel" useGeneratedKeys="true" keyProperty="modelId">
        insert into biz_device_model
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="modelName != null and modelName != ''">model_name,</if>
            <if test="description != null">description,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="modelName != null and modelName != ''">#{modelName},</if>
            <if test="description != null">#{description},</if>
         </trim>
    </insert>

    <update id="updateBizDeviceModel" parameterType="BizDeviceModel">
        update biz_device_model
        <trim prefix="SET" suffixOverrides=",">
            <if test="modelName != null and modelName != ''">model_name = #{modelName},</if>
            <if test="description != null">description = #{description},</if>
        </trim>
        where model_id = #{modelId}
    </update>

    <delete id="deleteBizDeviceModelByModelId" parameterType="Long">
        delete from biz_device_model where model_id = #{modelId}
    </delete>

    <delete id="deleteBizDeviceModelByModelIds" parameterType="String">
        delete from biz_device_model where model_id in 
        <foreach item="modelId" collection="array" open="(" separator="," close=")">
            #{modelId}
        </foreach>
    </delete>
</mapper>