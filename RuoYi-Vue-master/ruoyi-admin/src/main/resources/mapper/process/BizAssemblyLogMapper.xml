<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.process.mapper.BizAssemblyLogMapper">

    <resultMap type="com.ruoyi.process.domain.BizAssemblyLog" id="BizAssemblyLogResult">
        <result property="id"        column="log_id"        />
        <result property="serialNumber" column="serial_number" />

        <result property="modelCode"    column="model_name"    />
        <result property="videoUrl"     column="video_url"    />
        <result property="stepId"       column="step_id"       />
        <result property="assemblyRound" column="assembly_round" />
        <result property="processStage" column="process_stage" />
        <result property="workerName"   column="worker_name"   />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"      column="end_time"      />
        <result property="status"       column="status"        />
        <result property="remark"       column="remark"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
    </resultMap>

    <sql id="selectBizAssemblyLogVo">
        select
            l.log_id,
            l.serial_number,
            l.model_name,
            l.assembly_round,
            l.step_id,
            l.video_url,
            l.worker_name,
            l.start_time,
            l.end_time,
            l.status,
            l.create_time,
            IFNULL(s.step_title, l.process_stage) as process_stage
        from biz_assembly_log l
                 left join biz_sop_step s on l.step_id = s.step_id
    </sql>

    <select id="selectBizAssemblyLogList" parameterType="com.ruoyi.process.domain.BizAssemblyLog" resultMap="BizAssemblyLogResult">
        <include refid="selectBizAssemblyLogVo"/>
        <where>
            <if test="serialNumber != null  and serialNumber != ''"> and l.serial_number like concat('%', #{serialNumber}, '%')</if>
            <if test="modelCode != null  and modelCode != ''"> and l.model_name like concat('%', #{modelCode}, '%')</if>
            <if test="status != null and status != ''">
                and l.status in
                <foreach collection="status.split(',')" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="workerName != null  and workerName != ''"> and l.worker_name like concat('%', #{workerName}, '%')</if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(l.create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(l.create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
            </if>
        </where>
        order by l.create_time desc
    </select>

    <select id="selectBizAssemblyLogById" parameterType="Long" resultMap="BizAssemblyLogResult">
        <include refid="selectBizAssemblyLogVo"/>
        where log_id = #{id}
    </select>

    <select id="selectLastLog" resultMap="BizAssemblyLogResult">
        SELECT *
        FROM biz_assembly_log
        WHERE serial_number = #{serialNumber}
        AND step_id = #{stepId}
        AND assembly_round = #{assemblyRound}
        ORDER BY create_time DESC
        LIMIT 1
    </select>

    <select id="selectInProgressLog" resultMap="BizAssemblyLogResult">
        select * from biz_assembly_log
        where serial_number = #{deviceSn}
          and step_id = #{stepId}
          and assembly_round = #{round}
          and status = 'IN_PROGRESS'
        limit 1
    </select>

    <insert id="insertBizAssemblyLog" parameterType="com.ruoyi.process.domain.BizAssemblyLog" useGeneratedKeys="true" keyProperty="id">
        insert into biz_assembly_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="serialNumber != null">serial_number,</if>
            <if test="assemblyRound != null">assembly_round,</if>
            <if test="modelCode != null">model_name,</if>
            <if test="videoUrl != null">video_url,</if>
            <if test="stepId != null">step_id,</if>
            <if test="processStage != null">process_stage,</if>
            <if test="workerName != null">worker_name,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="serialNumber != null">#{serialNumber},</if>
            <if test="assemblyRound != null">#{assemblyRound},</if>
            <if test="modelCode != null">#{modelCode},</if>
            <if test="videoUrl != null">#{videoUrl},</if>
            <if test="stepId != null">#{stepId},</if>
            <if test="processStage != null">#{processStage},</if>
            <if test="workerName != null">#{workerName},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateBizAssemblyLog" parameterType="com.ruoyi.process.domain.BizAssemblyLog">
        update biz_assembly_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="modelCode != null">model_name = #{modelCode},</if>

            <if test="serialNumber != null">serial_number = #{serialNumber},</if>

            <if test="stepId != null">step_id = #{stepId},</if>

            <if test="processStage != null">process_stage = #{processStage},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where log_id = #{id}
    </update>

    <delete id="deleteBizAssemblyLogById" parameterType="Long">
        delete from biz_assembly_log where log_id = #{id}
    </delete>

    <delete id="deleteBizAssemblyLogByIds" parameterType="String">
        delete from biz_assembly_log where log_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>